// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`CTraceYamlDocument normalizes maps to the documented ctrace.yml order 1`] = `
"ctrace:
  created-by: CMSIS-Debugger
  setup:
    - pname: cm33
      disable:
      timestamps:
        clock: 100000000
        itm-prescaler: 4
      timesync:
      data:
        - location: watchedValue
          label: Watch
          access: R
          size: 4
          output: PC
          match:
            value: 0x30
            size: 4
      exceptions:
      events:
        - event: CYCCNT
          pname: cm33
      itm:
        enable: 0x1
        privileged: 0x0
      instructions:
        start:
          - location: main
            size: 4
        stop:
          - location: stopHere
            access: X
            match:
              value: 0x10
              size: 4
      pcsampling:
        period: 64
      synchronization:
        DWT: 16M
      tracehalt:
        - location: stopTrace
          access: X
          size: 4
          match:
            value: 0x20
            size: 2
"
`;
